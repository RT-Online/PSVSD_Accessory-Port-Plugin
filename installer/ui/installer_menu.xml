    </style_plane>
    <style_plane id="reboot_icon" planeobj="reboot_image">
      <planeobj id="reboot_image" texture0="icon_reboot"/>
    </style_plane>
    <style_text id="title_text" textobj="title_font">
      <textobj id="title_font" font_size="34" bold="1" align_x="1" align_y="1" color="1, 1, 1, 1"/>
    </style_text>
    <style_button id="menu_row" bg_obj="row_background" glow_obj="row_glow" label_obj="row_font" left_margin="149" right_margin="40" key_focus="1">
