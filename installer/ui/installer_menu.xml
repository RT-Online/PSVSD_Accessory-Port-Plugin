<?xml version="1.0" encoding="UTF-8"?>
<resource version="0.1" type="normal" id="accessory_mount_installer">
  <pagetable>
    <page id="accessory_mount_page">
      <plane style="installer_background" id="installer_root">
        <layout_hint size="960, 544"/>
        <text style="title_text" id="installer_title">
          <layout_hint size="880, 64" pos="0, 208"/>
        </text>
        <button style="menu_row" id="install_plugin" sound="_common_sound_button_enter">
          <layout_hint size="840, 80" pos="0, 136"/>
          <plane style="install_icon" hit_ignore="1"><layout_hint size="32, 32" pos="-302, 0"/></plane>
        </button>
        <button style="menu_row" id="uninstall_plugin" sound="_common_sound_button_enter">
