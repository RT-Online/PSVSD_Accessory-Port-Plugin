      <planeobj id="row_glow" texture0="_common_texture_list_glow_70px"/>
      <textobj id="row_font" font_size="25" align_x="1" align_y="0" color="1, 1, 1, 1"/>
    </style_button>
    <style_text id="status_text" textobj="status_font">
      <textobj id="status_font" font_size="22" align_x="1" align_y="1" word_wrap="1" color="1, 1, 1, 1"/>
    </style_text>
  </styletable>
  <stringtable/>
  <texturetable>
    <texture id="background_gradient" src="menu-background.png" type="texture/png"/>
  </texturetable>
  <filetable/>
</resource>
