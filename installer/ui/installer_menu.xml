  <stringtable/>
  <texturetable>
    <texture id="background_gradient" src="menu-background.png" type="texture/png"/>
    <texture id="icon_install" src="menu-install.png" type="texture/png"/>
    <texture id="icon_uninstall" src="menu-uninstall.png" type="texture/png"/>
    <texture id="icon_reboot" src="menu-reboot.png" type="texture/png"/>
  </texturetable>
  <filetable/>
