<?xml version="1.0" encoding="UTF-8"?>
<resource version="0.1" type="normal" id="accessory_mount_installer">
  <pagetable>
    <page id="accessory_mount_page">
      <plane style="installer_background" id="installer_root">
        <layout_hint size="960, 544"/>
        <text style="title_text" id="installer_title">
          <layout_hint size="920, 52" pos="0, 203"/>
        </text>
        <button style="menu_row" id="install_plugin" sound="_common_sound_button_enter">
          <layout_hint size="720, 70" pos="0, 111"/>
        </button>
        <button style="menu_row" id="uninstall_plugin" sound="_common_sound_button_enter">
          <layout_hint size="720, 70" pos="0, 37"/>
        </button>
        <button style="menu_row" id="reboot_device" sound="_common_sound_button_enter">
          <layout_hint size="720, 70" pos="0, -37"/>
        </button>
        <text style="status_text" id="operation_status">
          <layout_hint size="720, 100" pos="0, -146"/>
        </text>
        <corner_button style="_common_style_corner_bottom_left" id="exit_installer"/>
