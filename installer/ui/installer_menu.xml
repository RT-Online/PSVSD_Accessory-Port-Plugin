    <style_text id="title_text" textobj="title_font">
      <textobj id="title_font" font_size="32" align_x="0" align_y="0" color="1, 1, 1, 1"/>
    </style_text>
    <style_button id="menu_row" bg_obj="row_background" glow_obj="row_glow" label_obj="row_font" left_margin="24" key_focus="1">
